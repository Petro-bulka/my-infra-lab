global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node'
    static_configs:
      - targets:
          - '<VM1_IP>:9100'   # my-infra-lab
          - '<VM2_IP>:9100'   # target
          - '<VM3_IP>:9100'   # monitoring
